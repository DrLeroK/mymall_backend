# ==============================================================================
# MyMall Multi-Tenant SaaS E-Commerce Backend Environment Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your credentials.
# Note: In production, JWT secrets MUST be at least 32 characters long.

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3003
FRONTEND_URL=http://localhost:3003
PLATFORM_NAME="MyMall E-Commerce SaaS"
PLATFORM_BANK_INFO="Bank of Abyssinia / Telebirr - Account: 123456789 (MyMall Inc)"

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/mymall_db?schema=public"

# Docker Compose Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mymall_db
DOCKER_POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 3. JWT Authentication Secrets (Must be at least 32 characters in production)
# ------------------------------------------------------------------------------
JWT_SECRET=mymall_super_secret_jwt_token_key_min_32_chars_prod
JWT_REFRESH_SECRET=mymall_super_secret_refresh_token_key_min_32_chars_prod
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Email SMTP Settings (For Registration & Verification 6-Digit OTPs)
# ------------------------------------------------------------------------------
# Option A: Mailpit (Local Development & Testing - No credentials required)
# Start via Docker: docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
# Web UI: http://localhost:8025 | Inboxes all outgoing OTP emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="MyMall Local Dev" <noreply@mymall.local>

# Option B: Google Gmail SMTP (Production / Staging)
# Generate App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_google_app_password
# EMAIL_FROM="MyMall Platform" <your_email@gmail.com>

# ------------------------------------------------------------------------------
# 5. Chapa Payment Gateway (Ethiopian Payments: Telebirr, CBE Birr, Cards)
# ------------------------------------------------------------------------------
CHAPA_BASE_URL="https://api.chapa.co/v1"
CHAPA_PUBLIC_KEY="CHAPUBK_TEST-xxxxxx"
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxx"
CHAPA_WEBHOOK_SECRET="your_webhook_secret_here"

# ------------------------------------------------------------------------------
# 6. MapBox Provider API Key (For delivery geolocation and address coordinates)
# ------------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN="your_mapbox_token_here"

# ------------------------------------------------------------------------------
# 7. Database Seeding (Zero Data Loss Protected)
# ------------------------------------------------------------------------------
# When true, runs seed on initial container launch only if DB is empty
SEED_DATABASE=false
FORCE_SEED=false

# ------------------------------------------------------------------------------
# 8. Cloudflare R2 Cloud Object Storage (S3-Compatible API)
# ------------------------------------------------------------------------------
# Optional: If configured, images and proofs are uploaded to Cloudflare R2.
# If omitted or empty, MyMall automatically falls back to local disk storage (/uploads/).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# ==============================================================================
# MyMall Multi-Tenant Backend - Environment Configuration Template
# ==============================================================================

# Application Port & Environment
PORT=5001
NODE_ENV="development"
PLATFORM_NAME="MyMall E-Commerce SaaS"
# PLATFORM_BANK_INFO="Bank of Abyssinia / Telebirr - Account: 123456789 (MyMall Inc)"

# Database Configuration (PostgreSQL)
# For Local Non-Docker: postgresql://postgres:postgres@localhost:5432/mymall_db?schema=public
# For Docker Compose: automatically assembled from POSTGRES_* credentials below
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mymall_db?schema=public"

# Docker Compose Settings (used when running via docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mymall_db
DOCKER_POSTGRES_PORT=5434
SEED_DATABASE=true

# JWT Authentication Secrets
JWT_SECRET="your_secure_jwt_secret_key_change_in_production"
JWT_REFRESH_SECRET="your_secure_jwt_refresh_secret_key_change_in_production"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Email SMTP Settings (For Registration OTP, Password Reset & Verification)
# Example using Gmail App Password:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS="your_16_char_app_password"
EMAIL_FROM="MyMall E-Commerce <noreply@mymall.com>"

# Chapa Payment Gateway (Ethiopia Digital Payments: Telebirr, CBE Birr, Debit Cards)
# Sign up at https://dashboard.chapa.co to get your test/live keys
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_webhook_hash_secret

# Map Provider API Key (For delivery geolocation coordinates and map rendering)
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91cnVzZXJuYW1lIiwiYSI6InlvdXJ0b2tlbiJ9
GOOGLE_MAPS_API_KEY=AIzaSy...

{
  "name": "mymall_backend",
  "version": "1.0.0",
  "description": "Multi-tenant e-commerce backend platform with store onboarding, subscription billing, real-time inventory sync, POS integration, and screenshot payment verification.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "ts-node prisma/seed.ts",
    "test:unit": "ts-node tests/unit/index.ts",
    "test:integration": "ts-node tests/integration/index.ts",
    "test:e2e": "ts-node tests/e2e/index.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "mailpit": "./bin/mailpit"
  },
  "keywords": [
    "express",
    "prisma",
    "multi-tenancy",
    "ecommerce",
    "pos",
    "socket.io",
    "subscription-billing"
  ],
  "author": "MyMall Team",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}

# ==============================================================================
# Git Ignore Configuration for MyMall Multi-Tenant E-Commerce Backend
# ==============================================================================

# Dependencies
node_modules/
jspm_packages/
.pnp
.pnp.js

# Production and TypeScript Build Outputs
dist/
build/
out/
*.tsbuildinfo

# Environment & Secret Files (CRITICAL: Never commit sensitive keys or credentials)
.env
.env.production
.env.staging
.env.development
.env.local
.env.*.local
!.env.example

# Logs and Process IDs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# Test Coverage and Temporary Testing Artifacts
coverage/
.nyc_output/
*.lcov

# Prisma & Database Local Artifacts
prisma/*.db
prisma/*.db-journal

# Uploaded User Files (Keep folder structure, exclude binary uploads)
uploads/*/*
!uploads/*/.gitkeep

# IDE and Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker Local Volumes (if mounted locally)
postgres_data/
uploads_data/
